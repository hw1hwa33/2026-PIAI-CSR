{
  "name": "student-web-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "학생 성적 조회 웹서비스 만들기 — Git · GitHub · Docker · 웹 구조 인터랙티브 교안",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/consistency.cjs && node test/progress.cjs && node test/first-screen.cjs && node test/beginner.cjs && node test/a11y.cjs && npm run test:render",
    "test:consistency": "node test/consistency.cjs",
    "test:progress": "node test/progress.cjs",
    "test:first-screen": "node test/first-screen.cjs",
    "test:beginner": "node test/beginner.cjs",
    "test:a11y": "node test/a11y.cjs",
    "test:render": "vite build --ssr test/smoke.entry.jsx --outDir .smoke --emptyOutDir --logLevel warn && node .smoke/smoke.entry.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
